# Copy this file to .env.local and change what you need.
# Only variables that start with VITE_ reach the browser code.

# true (default): use the in-browser mock API in src/mocks.
# false: send requests to a real backend at VITE_API_BASE_URL.
VITE_USE_MOCK_API=true

# Where the API lives. Leave as /api for the mock.
VITE_API_BASE_URL=/api
